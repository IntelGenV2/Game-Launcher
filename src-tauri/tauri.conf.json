{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Studio 256 Game Launcher",
  "version": "0.3.9",
  "identifier": "com.intelgen.gamelauncher",
  "build": {
    "beforeDevCommand": "vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Studio 256 Game Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "windowEffects": {
          "effects": ["acrylic"]
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' asset: cover: http://asset.localhost https://asset.localhost http://cover.localhost https://cover.localhost data: blob: https:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost https://fonts.googleapis.com https://fonts.gstatic.com; object-src 'none'; base-uri 'self'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPDATA/IntelLauncher/**",
          "$APPDATA/IntelLauncher/covers/**",
          "$APPDATA/UnifiedGameLauncher/**",
          "$APPDATA/UnifiedGameLauncher/covers/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "publisher": "Studio 256",
    "shortDescription": "Cover-art game library for installed store games, plus Big Picture couch mode.",
    "longDescription": "Studio 256 Game Launcher scans local Steam, Epic, GOG, Xbox, and other store installs into one cover-art library. Launch games, organize groups, and use Big Picture for controller-first fullscreen browsing.",
    "createUpdaterArtifacts": true,
    "resources": { "icons/icon.ico": "studio-256-cartridge.ico" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "compression": "lzma",
        "installerHooks": "installer-upgrade.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhDMjg0MzhGQzI3RURDQTIKUldTaTNIN0NqME1vakxieFJFQVVSeEVKMTdRL2dYTm00TjQwQTF6ZkNaSHI3Vmc5L3BreGMydkcK",
      "endpoints": [
        "https://github.com/IntelGenV2/Game-Launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
