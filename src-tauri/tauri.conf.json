{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IntelGen Game Launcher",
  "version": "0.1.0",
  "identifier": "com.intelgen.gamelauncher",
  "build": {
    "beforeDevCommand": "vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "IntelGen Game Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "transparent": true,
        "decorations": true,
        "windowEffects": {
          "effects": ["acrylic"]
        }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/IntelLauncher/**",
          "$APPDATA\\IntelLauncher\\**",
          "$APPDATA/IntelLauncher/covers/**",
          "$APPDATA\\IntelLauncher\\covers\\**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
